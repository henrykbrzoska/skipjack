{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skipjack",
  "version": "0.1.0",
  "identifier": "app.skipjack.desktop",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/skipjack/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Skipjack",
        "width": 1120,
        "height": 780,
        "minWidth": 820,
        "minHeight": 580,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://img.youtube.com https://i.ytimg.com data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Mute & skip ads in YouTube TV apps",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
